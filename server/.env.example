# Server configuration
PORT=3000
NODE_ENV=production

# Resend API configuration
RESEND_API_KEY=your_resend_api_key_here

# Allowed origins for CORS (comma-separated list for dev and production domains)
CORS_ORIGIN=https://rudrekshdentalclinic.com,http://localhost:5174,http://localhost:5173

# Email routing configurations (Leave empty to use defaults, or set for production)
DOCTOR_EMAIL=info@rudrekshdentalclinic.com
FROM_EMAIL=Rudreksh Dental <appointments@rudrekshdentalclinic.com>
